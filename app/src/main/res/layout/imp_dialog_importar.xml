<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/color5">

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="IMPORTAR"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="@color/color1"
        android:gravity="center" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnImportarLista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="IMPORTAR LISTA"
        app:backgroundTint="@color/color1"
        android:textColor="@color/color5" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnImportarElementos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="IMPORTAR ELEMENTOS"
        app:strokeWidth="1dp"
        app:strokeColor="@color/color1"
        app:backgroundTint="@color/color1"
        android:textColor="@color/color5" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="CANCELAR"
        app:strokeWidth="1dp"
        app:strokeColor="@color/color1"
        app:backgroundTint="@color/color5"
        android:textColor="@color/color1" />

</LinearLayout>