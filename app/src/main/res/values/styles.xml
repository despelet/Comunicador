<?xml version="1.0" encoding="utf-8"?>
<resources>

<!--     le agrego esto para tema-->
    <!-- Base application theme -->
    <style name="Theme.App" parent="Theme.AppCompat.Light">
        <!-- Customize your theme here -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/color2</item>
        <item name="colorAccent">@color/color3</item>
        <item name="android:background">@color/color4</item>
    </style>
    <style name="NavDrawerText">
        <item name="android:textSize">18sp</item>

    </style>
    <style name="RoundedImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="DrawerButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/color7</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/color1</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="iconTint">@color/color1</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>


    <style name="CircleImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>
