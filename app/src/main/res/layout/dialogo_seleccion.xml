<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <!-- Botones de seleccionar/deseleccionar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnSeleccionarTodos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:background="@drawable/rounded_border_agregar"
            android:text="@string/seleccionar_todos"
            android:textSize="16sp"
            android:textColor="@color/color1"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"
            android:paddingVertical="10dp"
            android:paddingHorizontal="12dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:includeFontPadding="false" />

        <Button
            android:id="@+id/btnDeseleccionarTodos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:background="@drawable/rounded_border_agregar"
            android:text="@string/eliminar_seleccion"
            android:textSize="16sp"
            android:textColor="@color/color1"
            android:textStyle="bold"
            android:paddingVertical="10dp"
            android:paddingHorizontal="12dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Lista de selección -->
    <ListView
        android:id="@+id/listaItems"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="@color/white"
        android:divider="@color/color5"
        android:dividerHeight="1dp"
        android:choiceMode="multipleChoice"
        android:padding="4dp"/>
</LinearLayout>

