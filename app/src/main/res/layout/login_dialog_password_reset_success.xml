<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="24dp"
    app:cardBackgroundColor="@color/color5"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓"
            android:textSize="48sp"
            android:textStyle="bold"
            android:textColor="@color/color12" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¡Contraseña modificada!"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:textSize="22sp"
            android:textColor="@color/color1"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tu contraseña se actualizó correctamente. Ya podés iniciar sesión con tu nueva contraseña."
            android:textSize="14sp"
            android:textColor="@color/color1"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIrAIngresar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingresar"
            app:backgroundTint="@null"
            android:background="@drawable/gradient_purple"
            app:cornerRadius="12dp"
            android:textColor="@android:color/white"
            android:layout_marginTop="18dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>