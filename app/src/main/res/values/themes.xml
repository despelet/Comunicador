<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Comunic" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/color1</item>
        <item name="android:statusBarColor">@color/color5</item>
    </style>
    <style name="ThemeOverlay.Comunic.AlertDialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/color1</item>
    </style>

    <style name="Theme.Comunic.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="colorPrimary">@color/color1</item>
        <item name="android:statusBarColor">@color/color5</item>
        <item name="windowSplashScreenAnimatedIcon">
            @drawable/bicom_logo2
        </item>

        <item name="postSplashScreenTheme">
            @style/Theme.Comunic
        </item>
    </style>
</resources>


