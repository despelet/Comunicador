<?xml version="1.0" encoding="utf-8"?>
<!-- Contenido de HomeFragment (barra superior + panel de selección + RecyclerView) -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">



    <!-- Panel de selección -->
    <LinearLayout
        android:id="@+id/selectionPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/color5"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/cancelSelectionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableBottom="@android:drawable/ic_menu_revert"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/color5"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/selectionCountText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="@android:color/black"
            android:text="@string/_0_elementos_seleccionados" />

        <Button
            android:id="@+id/deleteSelectedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/eliminar_elementos"
            android:backgroundTint="@android:color/holo_red_dark"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <!-- RecyclerView para mostrar las imágenes -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/selectionPanel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@color/color5"
        android:visibility="gone"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/color5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- CONTENEDOR 1: TOP 6 elementos -->
            <LinearLayout
                android:id="@+id/contenedor_top6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"
                android:background="@color/color5">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recientes"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingBottom="4dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerTop6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <!-- CONTENEDOR 2: CATEGORÍAS -->
            <LinearLayout
                android:id="@+id/contenedor_categorias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"
                android:layout_marginTop="12dp"
                android:background="@color/color5">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Listas"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingBottom="4dp"/>

                <!-- 🔵 REEMPLAZA SOLO ESTA PARTE (Recycler + texto) -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="100dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerCategorias"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"/>

                    <TextView
                        android:id="@+id/textoDesarrolloCategorias"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/secci_n_en_desarrollo"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_gravity="center"
                        android:padding="16dp"/>

                </FrameLayout>
                <!-- 🔵 HASTA ACÁ -->

            </LinearLayout>

            <!-- CONTENEDOR 3:  -->
            <LinearLayout
                android:id="@+id/contenedor_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"
                android:layout_marginTop="12dp"
                android:background="@color/color5">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Modos"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingBottom="4dp"/>

                <!-- 🔵 REEMPLAZA SOLO ESTA PARTE (Recycler + texto) -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="100dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerModos"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"/>

                <TextView
                    android:id="@+id/textoDesarrolloModos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/secci_n_en_desarrollo"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_gravity="center"
                    android:padding="16dp"/>
                </FrameLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>